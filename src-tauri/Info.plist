<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WebKit only offers navigator.mediaDevices when the app says why it uses the microphone (remote desktops'
	     microphone redirection). Merged into the bundle's Info.plist, and embedded in dev builds. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Remote desktops can use your microphone when you turn on their microphone setting.</string>
</dict>
</plist>
