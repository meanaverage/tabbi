{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tabbi",
  "version": "0.1.0",
  "identifier": "io.github.meanaverage.tabbi",
  "build": {
    "frontendDist": "../.build/page"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "tabbi",
        "width": 1000,
        "height": 650,
        "minWidth": 400,
        "minHeight": 300,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"]
  }
}
